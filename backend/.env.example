# ── Local development ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# PostgreSQL connection string (docker-compose sets this automatically)
DATABASE_URL=postgresql+psycopg2://jobtracker:jobtracker@localhost:5432/jobtracker

# JWT signing secret — generate a strong one for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-production

# "development" | "production"
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Production only (Render sets DATABASE_URL automatically) ──────
# Leave these blank for local dev.
# DB_SECRET_JSON=
# DB_HOST=
# DB_PORT=5432
